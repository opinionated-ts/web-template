{
  "name": "@opinionated-ts/web-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/web-template.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "wouter-preact": "^3.11.1"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.8.10",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "unocss": "^66.10.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
